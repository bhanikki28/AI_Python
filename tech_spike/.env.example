# PII Gate configuration. All optional; defaults shown. No secrets are required.
# Copy to .env and `export $(cat .env | xargs)` or set in your shell / container.

PII_GATE_MAX_CHARS=10000        # max input characters (1-100000); larger input is BLOCKed
PII_GATE_LOG_LEVEL=INFO         # DEBUG | INFO | WARNING | ERROR
PII_GATE_HOST=127.0.0.1
PII_GATE_PORT=8000
# PII_GATE_POLICY_DIR=./policies  # directory of policy .md files (defaults to repo policies/)
